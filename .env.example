# MongoDB Atlas connection string. Keep server-side only.
MONGODB_URI=

# Auth.js: generate with `npx auth secret` for local development.
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# Used only by the controlled provisioning command; do not save here.
# Set TEACHER_EMAIL, TEACHER_NAME, and TEACHER_INITIAL_PASSWORD in the
# process environment only when running npm run provision:teacher.

# S3-compatible private object storage (Cloudflare R2 or another S3 service).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Brevo transactional email. EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=GNDEC Training & Placement
APP_BASE_URL=http://localhost:3001
INSTITUTIONAL_EMAIL_DOMAINS=gndec.ac.in,gmail.com

# Optional policy overrides. Defaults: 5-minute OTPs, 60-second resend cooldown,
# 5 attempts, 10 MB reports, and 15-day reporting intervals.
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
REPORT_MAX_SIZE_BYTES=10485760
REPORTING_INTERVAL_DAYS=15
INITIAL_REPORTING_DATE=

# Optional scheduled job protection token.
CRON_SECRET=
